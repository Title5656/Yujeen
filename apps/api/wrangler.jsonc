{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-tracker-m0-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-m0-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/database/migrations",
    },
  ],
}
